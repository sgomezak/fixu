# Copy to .env.local and fill in. Never commit .env.local.
# Phase 1+
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # the publishable key (sb_publishable_…) or legacy anon key
SUPABASE_SERVICE_ROLE_KEY=
FOOTBALL_DATA_API_KEY=
# Phase 2+
ANTHROPIC_API_KEY=
TRANSCRIPTION_API_KEY=
# Phase 3+
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Phase 4+
GARMIN_IMPORT_TOKEN=
# Only this email can use the app (server-side check)
FIXU_OWNER_EMAIL=
# "on" = sign-in required and calendar saved in Supabase; anything else = open app, browser storage
NEXT_PUBLIC_FIXU_AUTH=
